# Credentials for scripts/release-macos.sh (and `tauri build`'s own signing).
# Copy this file to ".env" (git-ignored) and fill in. NEVER commit the real .env.

# Code-signing identity used by `tauri build`.
# Exact string from:  security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Fusionbase GmbH (J384SF3R3J)"

# --- Notarization: provide ONE of the two routes below ----------------------

# Route A - App Store Connect API key (recommended: no expiry, scriptable)
#APPLE_API_KEY_PATH="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"
#APPLE_API_KEY="XXXXXXXXXX"                                  # Key ID
#APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"     # Issuer ID

# Route B - Apple ID + app-specific password
# (create one at appleid.apple.com -> Sign-In and Security -> App-Specific Passwords)
APPLE_ID="patrick.holl@fusionbase.com"
APPLE_TEAM_ID="J384SF3R3J"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"                         # app-specific password, NOT your Apple ID password
